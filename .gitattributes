# 统一换行符，避免跨平台协作时的 CRLF 污染
# 不加这个文件，Windows 用户 clone 后 shell 脚本会因 CRLF 报
# "bad interpreter: /usr/bin/env: No such file or directory"

# 默认：文本文件在仓库中一律存 LF
* text=auto eol=lf

# Shell 脚本必须 LF（否则 Linux/macOS 无法执行）
*.sh    text eol=lf
*.bash  text eol=lf

# Windows 脚本用 CRLF（PowerShell / cmd 更友好）
*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf

# 明确文本类型
*.py    text
*.md    text
*.yaml  text
*.yml   text
*.json  text
*.txt   text

# 二进制：禁止任何转换与 diff
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.db    binary
*.sqlite binary
*.zip   binary
*.pdf   binary

# 让 git diff 正确识别
*.py    diff=python
